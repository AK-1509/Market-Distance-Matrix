{
  "name": "market-landscape",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first competitive landscape generator: modeled market-distance matrix, exact IDV distance bars and a constrained radial map.",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "dexie": "4.2.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.1.13"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "5.2.0",
    "fake-indexeddb": "6.2.5",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.11"
  },
  "overrides": {
    "vite": "$vite"
  }
}
